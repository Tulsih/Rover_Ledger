# Server Configuration
PORT=3003
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=rover_ledger
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/rover_ledger

# JWT Configuration
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d
JWT_ACCESS_SECRET=your_jwt_access_secret_key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key
JWT_REFRESH_EXPIRES_IN=7d

# Microsoft Azure Entra ID OAuth Credentials
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_TENANT_ID=your_microsoft_tenant_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_REDIRECT_URI=roverledger://auth

# Microsoft OneDrive / SharePoint Storage Credentials
MICROSOFT_DRIVE_ID=your_onedrive_drive_id
MICROSOFT_FOLDER_ID=your_onedrive_folder_id

# Security & Testing Flags
ENABLE_MOCK_LOGIN=false
