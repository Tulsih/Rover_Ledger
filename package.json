{
  "name": "rover-ledger",
  "version": "1.0.0",
  "description": "Rover Ledger - Node.js Express & Drizzle ORM backend with Microsoft OAuth login",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "node test_endpoints.js && node test_documents.js",
    "test:auth": "node test_endpoints.js",
    "test:documents": "node test_documents.js",
    "Db:generate": "drizzle-kit generate",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push --force",
    "Db:push": "drizzle-kit push --force"
  },
  "keywords": [
    "nodejs",
    "express",
    "drizzle-orm",
    "microsoft-login",
    "oauth2"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "nodemon": "^3.1.14"
  }
}
